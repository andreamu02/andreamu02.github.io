---
const { title, description, tags, repo } = Astro.props as { title: string; description: string; tags: string[]; repo?: string };
---
<article class="project">
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="tags">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  {repo && (
    <a class="project-link" href={repo} target="_blank" rel="noopener noreferrer">
      View on GitHub &rarr;
    </a>
  )}
</article>
